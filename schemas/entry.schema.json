{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "GUI Failure Taxonomy Entry List",
    "type": "array",
    "items": {
        "type": "object",
        "required": [
            "id",
            "platform",
            "agent_type",
            "category",
            "failure",
            "description",
            "cause",
            "stage"
        ],
        "additionalProperties": false,
        "properties": {
            "id": {
                "type": "string",
                "pattern": "^F-(WEB|MOB|DSK|XPL)-(VO|TO|MM)-(PRC|IDF|STR|AFD|NAV|CNT|FBK|TMP|SCP)-\\d{3}$",
                "description": "Unique failure identifier, e.g. F-WEB-MM-PRC-001"
            },
            "platform": {
                "type": "string",
                "enum": ["web", "mobile", "desktop", "cross-platform"]
            },
            "agent_type": {
                "type": "string",
                "enum": ["vision-only", "text-only", "multimodal"]
            },
            "category": {
                "type": "string",
                "enum": [
                    "perceptibility",
                    "identifiability",
                    "structural_consistency",
                    "interaction_affordance",
                    "navigation_discoverability",
                    "content_organization",
                    "state_feedback",
                    "temporal_dynamics",
                    "interaction_scope"
                ]
            },
            "failure": {
                "type": "string",
                "pattern": "^[a-z0-9_]+$",
                "description": "Snake-case root-cause identifier"
            },
            "description": {
                "type": "string"
            },
            "assessment_ref": {
                "type": "string",
                "pattern": "^F[1-9]\\.[0-9]+$",
                "description": "Cross-reference to the F1.1-F9.7 ID in failure-assessment.md"
            },
            "cause": {
                "type": "string",
                "enum": ["software-side", "agent-side", "joint"]
            },
            "stage": {
                "type": "string",
                "enum": ["prediction", "execution", "unclear"]
            },
            "examples": {
                "type": "array",
                "items": {
                    "type": "object",
                    "required": ["scenario_id", "source", "app"],
                    "additionalProperties": false,
                    "properties": {
                        "scenario_id": {
                            "type": "string",
                            "pattern": "^F-(WEB|MOB|DSK|XPL)-(VO|TO|MM)-(PRC|IDF|STR|AFD|NAV|CNT|FBK|TMP|SCP)-\\d{3}-[a-z]$"
                        },
                        "source": {
                            "type": "string",
                            "enum": [
                                "controlled",
                                "live",
                                "benchmark",
                                "literature"
                            ]
                        },
                        "app": { "type": "string" },
                        "route": { "type": "string" },
                        "task": { "type": "string" },
                        "notes": { "type": "string" }
                    }
                }
            }
        }
    }
}
